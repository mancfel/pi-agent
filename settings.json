{
  "lastChangelogVersion": "0.99.2",
  "packages": [
    "https://github.com/gsanhueza/pi-token-speed",
    {
      "source": "npm:pi-memory",
      "extensions": [
        "-index.ts"
      ]
    },
    "npm:pi-unsloth-webtools",
    "npm:@juicesharp/rpiv-ask-user-question",
    {
      "source": "npm:pi-agent-browser-native",
      "extensions": [
        "-dist\\extensions\\agent-browser\\index.js"
      ]
    },
    {
      "source": "npm:pi-prompt-tracker",
      "extensions": [
        "-extensions\\prompt-tracker.ts"
      ]
    }
  ],
  "defaultProvider": "ollama",
  "defaultModel": "gemma-4",
  "defaultTools": [
    "read",
    "powershell",
    "edit",
    "write"
  ],
  "theme": "dark",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "extensions": [
    "-extensions\\wiki-ingest.ts"
  ]
}